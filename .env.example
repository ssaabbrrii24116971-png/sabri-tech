# ─────────────────────────────────────────────────────────────
#  Variables d'environnement — SABRI TECH
#  En local : copiez ce fichier en .env.local et remplissez-le.
#  Sur Vercel : Project → Settings → Environment Variables (mêmes noms).
#  Toutes ces variables sont FACULTATIVES : le site fonctionne sans.
#  ⚠️ Ne mettez jamais de mot de passe ou de clé secrète dans une
#     variable NEXT_PUBLIC_ : elle est visible par tous les visiteurs.
# ─────────────────────────────────────────────────────────────

# Identifiant du Meta Pixel (chiffres uniquement).
# Où le trouver : Gestionnaire d'événements Meta → Sources de données → votre pixel.
# Vide = aucun script Meta chargé.
NEXT_PUBLIC_META_PIXEL_ID=

# Adresse publique du site, sans "/" final (ex. https://www.nexoratech.tn).
# Vide = Vercel utilise automatiquement son domaine de production (xxx.vercel.app).
NEXT_PUBLIC_SITE_URL=

# ── Meta Conversions API (relais pour l'application mobile : /api/meta/events) ──
# Jeton SECRET (Gestionnaire d'événements → votre dataset → Paramètres → Conversions API → Générer un jeton).
# Ne jamais le préfixer par NEXT_PUBLIC_. Vide = le relais accepte les événements sans rien envoyer.
META_CAPI_ACCESS_TOKEN=
# Identifiant du dataset si différent de NEXT_PUBLIC_META_PIXEL_ID (facultatif).
META_DATASET_ID=
# Code de test affiché dans « Tester les événements » (facultatif, à retirer en production).
META_TEST_EVENT_CODE=
# 1 = renvoie le payload sans l'envoyer à Meta (tests).
META_CAPI_DRY_RUN=
